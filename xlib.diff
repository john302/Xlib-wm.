+int supports_delete(Window w) {
+    Atom *protocols;
+    int n = 0;
+    Atom wm_delete = XInternAtom(display, "WM_DELETE_WINDOW", False);
+
+    if (XGetWMProtocols(display, w, &protocols, &n)) {
+        for (int i = 0; i < n; i++) {
+            if (protocols[i] == wm_delete) {
+                XFree(protocols);
+                return 1;
+            }
+        }
+        XFree(protocols);
+    }
+
+    return 0;
+}
